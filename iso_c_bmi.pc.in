prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/iso_c_fortran_bmi

Name: iso_c_bmi
Description: ISO C Fortran BMI bindings
Version: @PROJECT_VERSION@

Requires:
Libs: -L${libdir} -liso_c_bmi
Cflags: -I${includedir}
